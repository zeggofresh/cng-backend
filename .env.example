# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Neon PostgreSQL or any PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password

# For Neon PostgreSQL, use the connection string format:
# DB_HOST=your-endpoint-pooler.c-REGION.aws.neon.tech
# DB_NAME=neondb
# DB_USER=neondb_owner
# DB_PASSWORD=npg_xxxxxxxxxxxxx

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345
JWT_EXPIRE=7d

# CORS Configuration
CORS_ORIGIN=*

# Email Configuration (Optional - for future email notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password

# SMS Configuration (Optional - for future SMS notifications)
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=YOUR_APP
