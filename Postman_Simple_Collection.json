{
  "info": {
    "_postman_id": "cng-finder-simple-api",
    "name": "CNG Finder - Simple API",
    "description": "Simple authentication API - Signup, Login, Forgot Password, Get User",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Signup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"emailOrPhone\": \"john@example.com\",\n  \"password\": \"Pass123\",\n  \"confirmPassword\": \"Pass123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/signup",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "signup"]
        },
        "description": "Register new user with email/phone + password"
      },
      "response": []
    },
    {
      "name": "2. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const jsonData = pm.response.json();",
              "    pm.environment.set('auth_token', jsonData.data.token);",
              "    pm.environment.set('userId', jsonData.data.user.id);",
              "    console.log('Token saved:', jsonData.data.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"emailOrPhone\": \"john@example.com\",\n  \"password\": \"Pass123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Login with email/phone + password. Token auto-saved."
      },
      "response": []
    },
    {
      "name": "3. Get User Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/user",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "user"]
        },
        "description": "Get current user profile (requires auth token)"
      },
      "response": []
    },
    {
      "name": "4. Forgot Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"emailOrPhone\": \"john@example.com\",\n  \"newPassword\": \"NewPass123\",\n  \"confirmPassword\": \"NewPass123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/forgot-password",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "forgot-password"]
        },
        "description": "Reset password using email/phone"
      },
      "response": []
    },
    {
      "name": "5. Find Nearby CNG Pumps",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": 28.7041,\n  \"longitude\": 77.1025,\n  \"radius_km\": 5\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/cng/nearby",
          "host": ["{{base_url}}"],
          "path": ["api", "cng", "nearby"]
        },
        "description": "Find CNG pumps near your location. Public endpoint."
      },
      "response": []
    },
    {
      "name": "6. Save Location for Notifications",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": 28.7041,\n  \"longitude\": 77.1025,\n  \"radius_km\": 5,\n  \"notifications_enabled\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/cng/location",
          "host": ["{{base_url}}"],
          "path": ["api", "cng", "location"]
        },
        "description": "Save your location to receive notifications when CNG pumps are nearby"
      },
      "response": []
    },
    {
      "name": "7. Check for Nearby CNG Notifications",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/cng/check-notifications",
          "host": ["{{base_url}}"],
          "path": ["api", "cng", "check-notifications"]
        },
        "description": "Check for nearby CNG pumps and create notifications"
      },
      "response": []
    },
    {
      "name": "8. Get My Notifications",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/cng/notifications",
          "host": ["{{base_url}}"],
          "path": ["api", "cng", "notifications"]
        },
        "description": "Get all your CNG pump notifications"
      },
      "response": []
    },
    {
      "name": "9. Mark Notification as Read",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/cng/notifications/1/read",
          "host": ["{{base_url}}"],
          "path": ["api", "cng", "notifications", "1", "read"]
        },
        "description": "Mark a specific notification as read (change ID in URL)"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://cng-backend-production-03e7.up.railway.app",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ]
}
