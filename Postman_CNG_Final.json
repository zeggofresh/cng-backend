{
  "info": {
    "_postman_id": "cng-finder-api-v1",
    "name": "CNG Finder API - Complete",
    "description": "CNG Pump Finder - Search, Find Nearest, Check Stock & Navigation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Signup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"emailOrPhone\": \"rahul@example.com\",\n  \"password\": \"Pass123\",\n  \"confirmPassword\": \"Pass123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/signup",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "signup"]
        },
        "description": "Register new user with email/phone"
      },
      "response": []
    },
    {
      "name": "2. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const jsonData = pm.response.json();",
              "    pm.environment.set('auth_token', jsonData.data.token);",
              "    console.log('✅ Token saved:', jsonData.data.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"emailOrPhone\": \"rahul@example.com\",\n  \"password\": \"Pass123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Login with email/phone - Auto saves token"
      },
      "response": []
    },
    {
      "name": "3. Get User Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/user",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "user"]
        },
        "description": "Get logged in user profile"
      },
      "response": []
    },
    {
      "name": "4. Search CNG Pumps",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cng/search?q=IGL",
          "host": ["{{base_url}}"],
          "path": ["api", "cng", "search"],
          "query": [
            {
              "key": "q",
              "value": "IGL",
              "description": "Search by: pump name, city, area, address"
            }
          ]
        },
        "description": "🔍 Search CNG pumps by name, city, or area\n\nExamples:\n- IGL (name)\n- Dwarka (area)\n- Delhi (city)\n- Connaught Place (address)"
      },
      "response": []
    },
    {
      "name": "5. Find Nearest CNG Pump",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cng/nearest?latitude=28.7041&longitude=77.1025",
          "host": ["{{base_url}}"],
          "path": ["api", "cng", "nearest"],
          "query": [
            {
              "key": "latitude",
              "value": "28.7041",
              "description": "Your current latitude"
            },
            {
              "key": "longitude",
              "value": "77.1025",
              "description": "Your current longitude"
            }
          ]
        },
        "description": "📍 Find NEAREST CNG pump from your location\n\nQuery Parameters:\n- latitude: Your location latitude\n- longitude: Your location longitude\n\nReturns:\n- Pump name\n- Distance (km)\n- Stock availability\n- Open/Closed status\n- Google Maps navigation link"
      },
      "response": []
    },
    {
      "name": "6. All Nearby CNG Pumps",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cng/all-nearby?latitude=28.7041&longitude=77.1025&radius_km=10",
          "host": ["{{base_url}}"],
          "path": ["api", "cng", "all-nearby"],
          "query": [
            {
              "key": "latitude",
              "value": "28.7041",
              "description": "Your current latitude"
            },
            {
              "key": "longitude",
              "value": "77.1025",
              "description": "Your current longitude"
            },
            {
              "key": "radius_km",
              "value": "10",
              "description": "Search radius in km (default: 10)"
            }
          ]
        },
        "description": "🗺️ Get ALL CNG pumps within radius\n\nQuery Parameters:\n- latitude: Your location\n- longitude: Your location\n- radius_km: Search radius (default 10km)\n\nSorted by:\n- Stock availability\n- Distance\n- Open status"
      },
      "response": []
    },
    {
      "name": "7. Get Pump Details",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cng/pump/1",
          "host": ["{{base_url}}"],
          "path": ["api", "cng", "pump", "1"]
        },
        "description": "ℹ️ Get full details of specific CNG pump\n\nChange pump ID in URL (1, 2, 3, etc.)"
      },
      "response": []
    },
    {
      "name": "8. Update Stock Status",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pump_id\": 1,\n  \"has_stock\": true,\n  \"stock_level\": \"High\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/cng/update-stock",
          "host": ["{{base_url}}"],
          "path": ["api", "cng", "update-stock"]
        },
        "description": "🔄 Update CNG pump stock status\n\nstock_level: Low, Medium, or High\nhas_stock: true or false"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://cng-backend-production-03e7.up.railway.app",
      "type": "string",
      "description": "Production API Base URL"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string",
      "description": "JWT Token (auto-saved after login)"
    }
  ]
}
